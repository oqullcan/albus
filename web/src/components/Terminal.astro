---
---
<section class="block">
  <div class="wrap">
    <div class="duo rv">
      <div class="feat">
        <h4>CENSORSHIP-RESISTANT</h4>
        <p>A shaping watchdog reconciles live connections against kernel perf events. Flows nobody can explain trigger lockdown — the daemon assumes breach, not luck.</p>
        <h4>LINUX-NATIVE</h4>
        <p>One static binary, one systemd unit, one unprivileged daemon user. No containers, no relays, no account, no one to subpoena.</p>
        <h4>EASY TO USE</h4>
        <p>Three commands to install, sane defaults, nothing to tune. A panel widget shows state at a glance for daily driving.</p>
        <p style="margin-top:30px"><a class="btn" href="#faq">Frequently asked questions</a></p>
      </div>
      <div class="term" role="img" aria-label="Albus status output">
        <div class="term-bar"><span>STATUS</span><span class="dots"><i></i><i></i><i></i></span></div>
        <svg class="term-rays" viewBox="0 0 400 150" aria-hidden="true">
          <g class="rays" stroke="rgba(255,255,255,0.22)" stroke-width="1" stroke-dasharray="2 4">
            <line x1="20" y1="0" x2="200" y2="138" /><line x1="60" y1="0" x2="200" y2="138" />
            <line x1="100" y1="0" x2="200" y2="138" /><line x1="140" y1="0" x2="200" y2="138" />
            <line x1="180" y1="0" x2="200" y2="138" /><line x1="220" y1="0" x2="200" y2="138" />
            <line x1="260" y1="0" x2="200" y2="138" /><line x1="300" y1="0" x2="200" y2="138" />
            <line x1="340" y1="0" x2="200" y2="138" /><line x1="380" y1="0" x2="200" y2="138" />
          </g>
          <circle class="ping" cx="200" cy="138" r="8" fill="none" stroke="rgba(255,255,255,0.35)" />
          <circle cx="200" cy="138" r="3.5" fill="#f5f5f5" />
          <circle cx="200" cy="138" r="8" fill="none" stroke="rgba(255,255,255,0.3)" />
          <circle r="2.2" fill="#f5f5f5">
            <animateMotion dur="2.6s" repeatCount="indefinite" path="M60,0 L200,138" />
          </circle>
          <circle r="2.2" fill="#f5f5f5">
            <animateMotion dur="3.4s" begin="1.1s" repeatCount="indefinite" path="M340,0 L200,138" />
          </circle>
          <circle r="2.2" fill="#f5f5f5">
            <animateMotion dur="4.1s" begin="2.3s" repeatCount="indefinite" path="M140,0 L200,138" />
          </circle>
        </svg>
        <div class="term-body typing" id="status-term">
          <span class="tline"><span class="p">$ </span>albus status</span>
          <span class="tline"><span class="ok">● engine active</span> <span class="dim">(eBPF sock_ops)</span></span>
          <span class="tline"><span class="ok">● dns 127.0.0.1:53</span> <span class="dim">(DoH, validated)</span></span>
          <span class="tline"><span class="ok">● kill-switch on</span> <span class="dim">— 0 leaks</span></span>
          <span class="tline"><span class="p">$ </span><span class="cursor"></span></span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const term = document.getElementById('status-term');
    if (!term) return;
    const lines = [...term.querySelectorAll('.tline')];
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      term.classList.remove('typing');
      const svg = term.closest('.term')?.querySelector('svg');
      if (svg && 'pauseAnimations' in svg) svg.pauseAnimations();
      return;
    }
    let done = false;
    new IntersectionObserver(([e], obs) => {
      if (!e.isIntersecting || done) return;
      done = true;
      obs.disconnect();
      lines.forEach((ln, i) => setTimeout(() => ln.classList.add('shown'), 350 + i * 420));
    }, { threshold: 0.4 }).observe(term);
  })();
</script>

<style>
  .term-body.typing .tline { display: block; opacity: 0; transform: translateX(6px); transition: opacity 0.45s ease, transform 0.45s ease; }
  .term-body.typing .tline.shown { opacity: 1; transform: none; }
  .term-body:not(.typing) .tline { display: block; }
</style>
